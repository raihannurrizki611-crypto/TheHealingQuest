package com.mycompany.thehealingquest;

/**
 * AnimState.java
 * Enum untuk state animasi karakter (Player maupun NPC).
 *
 * KONSEP OOP:
 *  - Enkapsulasi : nilai state tersimpan rapi dalam enum, tidak pakai int/String mentah
 *  - Digunakan oleh : Character (parent), Player, NPC
 */
public enum AnimState {

    /** Karakter diam, memainkan animasi idle */
    IDLE,

    /** Karakter berjalan ke kiri atau kanan */
    WALKING
}
